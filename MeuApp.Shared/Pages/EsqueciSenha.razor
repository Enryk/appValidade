@page "/esqueci-senha"
@layout MeuApp.Shared.Layout.AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-brand-badge badge-reset">
            <span class="auth-brand-icon">🔑</span>
        </div>
        <h1 class="auth-title">Recuperar Senha</h1>
        <p class="auth-subtitle">Informe seu e-mail cadastrado para enviarmos as instruções de redefinição</p>
    </div>

    @if (!string.IsNullOrEmpty(mensagemErro))
    {
        <div class="auth-alert alert-danger">
            <span>⚠️ @mensagemErro</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensagemSucesso))
    {
        <div class="auth-alert alert-success">
            <span>✅ @mensagemSucesso</span>
        </div>
    }

    @if (emailEnviado)
    {
        <div class="prosseguir-box">
            <p class="prosseguir-desc">
                Enviamos as instruções e o código para <strong>@email</strong>. Acesse seu e-mail e clique no botão abaixo para cadastrar sua nova senha:
            </p>
            <button type="button" class="btn-auth-primary" @onclick="IrParaRedefinicao">
                <span>Digitar Código & Nova Senha →</span>
            </button>
        </div>
    }
    else
    {
        <form @onsubmit="EnviarSolicitacao" class="auth-form">
            <div class="form-group">
                <label class="form-label" for="reset-email">E-mail Cadastrado</label>
                <div class="input-wrapper">
                    <span class="input-icon">✉️</span>
                    <input id="reset-email" 
                           type="email" 
                           class="form-control" 
                           placeholder="seu.email@exemplo.com" 
                           @bind="email" 
                           required 
                           autofocus />
                </div>
                <span class="field-hint">Enviaremos um código de 6 dígitos e um link seguro para este endereço.</span>
            </div>

            <button type="submit" class="btn-auth-primary" disabled="@carregando">
                @if (carregando)
                {
                    <span class="spinner-sm"></span>
                    <span>Enviando e-mail...</span>
                }
                else
                {
                    <span>Enviar E-mail de Redefinição</span>
                }
            </button>
        </form>
    }

    <div class="auth-footer">
        <p class="footer-text">
            Lembrou da senha? 
            <a href="/login" class="footer-link">Voltar para o Login</a>
        </p>
    </div>
</div>

@code {
    private string email = "";
    private bool carregando = false;
    private bool emailEnviado = false;
    private string? mensagemErro;
    private string? mensagemSucesso;

    private async Task EnviarSolicitacao()
    {
        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
        {
            mensagemErro = "Por favor, digite um e-mail válido.";
            return;
        }

        mensagemErro = null;
        mensagemSucesso = null;
        carregando = true;

        try
        {
            var res = await AuthService.SolicitarRecuperacaoSenhaAsync(email, Navigation.BaseUri);
            if (res.Sucesso)
            {
                emailEnviado = true;
                mensagemSucesso = res.Mensagem;
            }
            else
            {
                mensagemErro = res.Mensagem;
            }
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro ao solicitar recuperação: " + ex.Message;
        }
        finally
        {
            carregando = false;
        }
    }

    private void IrParaRedefinicao()
    {
        Navigation.NavigateTo($"/redefinir-senha?email={Uri.EscapeDataString(email)}");
    }
}
