@page "/cadastrar"
@layout MeuApp.Shared.Layout.AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-brand-badge">
            <span class="auth-brand-icon">✨</span>
        </div>
        <h1 class="auth-title">Criar Conta</h1>
        <p class="auth-subtitle">Cadastre-se para começar a controlar validades</p>
    </div>

    @if (!string.IsNullOrEmpty(mensagemErro))
    {
        <div class="auth-alert alert-danger">
            <span>⚠️ @mensagemErro</span>
        </div>
    }

    @if (cadastroIniciado)
    {
        <div class="auth-alert alert-success">
            <span>🎉 E-mail de validação enviado com sucesso!</span>
            <p style="margin: 10px 0 0 0; font-size: 0.9rem; line-height: 1.5; color: #166534; font-weight: normal;">
                Enviamos um link seguro para <strong>@email</strong>.<br />
                Acesse sua caixa de entrada e clique no link para <strong>definir a sua senha</strong> e ativar a sua conta.
            </p>
        </div>

        <div class="auth-footer">
            <p class="footer-text">
                Deseja voltar à tela inicial? 
                <a href="/login" class="footer-link">Ir para o Login</a>
            </p>
        </div>
    }
    else
    {
        <form @onsubmit="EfetuarCadastro" class="auth-form">
            <div class="form-group">
                <label class="form-label" for="cad-nome">Nome Completo</label>
                <div class="input-wrapper">
                    <span class="input-icon">👤</span>
                    <input id="cad-nome" 
                           type="text" 
                           class="form-control" 
                           placeholder="Ex: Carlos Silva" 
                           @bind="nome" 
                           required 
                           autofocus />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="cad-email">E-mail para Validação</label>
                <div class="input-wrapper">
                    <span class="input-icon">✉️</span>
                    <input id="cad-email" 
                           type="email" 
                           class="form-control" 
                           placeholder="seu.email@exemplo.com" 
                           @bind="email" 
                           required />
                </div>
                <span class="field-hint">Enviaremos um link seguro para você definir sua senha e ativar o acesso.</span>
            </div>

            <div class="info-validacao-box">
                <span class="info-validacao-icon">ℹ️</span>
                <span class="info-validacao-text">
                    Ao confirmar, você receberá um e-mail com o link para escolher sua senha pessoal (mínimo de 6 caracteres, com letra maiúscula, minúscula e caractere especial).
                </span>
            </div>

            <button type="submit" class="btn-auth-primary" disabled="@carregando">
                @if (carregando)
                {
                    <span class="spinner-sm"></span>
                    <span>Enviando e-mail de ativação...</span>
                }
                else
                {
                    <span>Cadastrar & Receber E-mail</span>
                }
            </button>
        </form>

        <div class="auth-footer">
            <p class="footer-text">
                Já possui uma conta? 
                <a href="/login" class="footer-link">Entrar no sistema</a>
            </p>
        </div>
    }
</div>

@code {
    private string nome = "";
    private string email = "";
    private bool carregando = false;
    private bool cadastroIniciado = false;
    private string? mensagemErro;

    private async Task EfetuarCadastro()
    {
        mensagemErro = null;

        if (string.IsNullOrWhiteSpace(nome))
        {
            mensagemErro = "Por favor, informe seu nome.";
            return;
        }

        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
        {
            mensagemErro = "Por favor, informe um e-mail válido.";
            return;
        }

        carregando = true;
        try
        {
            var res = await AuthService.IniciarCadastroAsync(nome, email, Navigation.BaseUri);
            if (res.Sucesso)
            {
                cadastroIniciado = true;
            }
            else
            {
                mensagemErro = res.Mensagem;
            }
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro ao cadastrar: " + ex.Message;
        }
        finally
        {
            carregando = false;
        }
    }
}
