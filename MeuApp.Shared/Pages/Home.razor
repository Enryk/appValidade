@page "/"
@namespace MeuApp.Shared.Pages
@inject IValidadeService ValidadeService
@inject IJSRuntime JSRuntime

<div class="monitoramento-page">
    <header class="page-header">
        <div class="header-titles">
            <h1 class="page-title">Monitoramento de Validades</h1>
            <p class="page-subtitle">Acompanhamento e controle de prazos por loja em tempo real</p>
        </div>

        <div class="header-actions">
            <a href="coleta" class="btn-ir-coleta">
                📟 Bipar / Coletar Validades
            </a>
        </div>
    </header>

    <!-- Resumo em Métricas -->
    <div class="stats-grid">
        <div class="stat-card" @onclick='() => AplicarFiltroRapido("todos")'>
            <span class="stat-num">@validades.Count</span>
            <span class="stat-lbl">Total Ativos</span>
        </div>
        <div class="stat-card stat-danger" @onclick='() => AplicarFiltroRapido("vencidos")'>
            <span class="stat-num">@validades.Count(v => v.EstaVencido)</span>
            <span class="stat-lbl">Vencidos (Alerta)</span>
        </div>
        <div class="stat-card stat-warning" @onclick='() => AplicarFiltroRapido("7dias")'>
            <span class="stat-num">@validades.Count(v => !v.EstaVencido && v.DiasRestantes <= 7)</span>
            <span class="stat-lbl">Até 7 Dias</span>
        </div>
        <div class="stat-card stat-promo">
            <span class="stat-num">@validades.Count(v => v.EmPromocao)</span>
            <span class="stat-lbl">Em Promoção</span>
        </div>
    </div>

    <!-- Barra de Filtro de Loja e Filtros Rápidos -->
    <div class="filtros-container">
        <div class="filtro-linha-superior">
            <div class="filtro-loja-group">
                <label class="filtro-label">Filtrar por Loja:</label>
                <select class="select-loja" @bind="lojaFiltroId" @bind:after="CarregarValidades">
                    <option value="0">🏬 Todas as Lojas</option>
                    @foreach (var loja in lojas)
                    {
                        <option value="@loja.Id">@loja.Nome (@loja.CodigoLoja)</option>
                    }
                </select>
            </div>

            <div class="atalhos-filtros-rapidos">
                <button type="button" 
                        class="btn-filtro-atalho @(filtroRapido == "7dias" ? "active" : "")"
                        @onclick='() => AplicarFiltroRapido("7dias")'>
                    ⏳ Até 7 Dias
                </button>
                <button type="button" 
                        class="btn-filtro-atalho @(filtroRapido == "10dias" ? "active" : "")"
                        @onclick='() => AplicarFiltroRapido("10dias")'>
                    ⏳ Até 10 Dias
                </button>
                <button type="button" 
                        class="btn-filtro-atalho @(filtroRapido == "15dias" ? "active" : "")"
                        @onclick='() => AplicarFiltroRapido("15dias")'>
                    ⏳ Até 15 Dias
                </button>
                <button type="button" 
                        class="btn-filtro-atalho btn-atalho-vencido @(filtroRapido == "vencidos" ? "active" : "")"
                        @onclick='() => AplicarFiltroRapido("vencidos")'>
                    🚨 Vencidos
                </button>
                <button type="button" 
                        class="btn-filtro-atalho @(filtroRapido == "personalizado" ? "active" : "")"
                        @onclick='() => AplicarFiltroRapido("personalizado")'>
                    📅 Personalizado
                </button>
                <button type="button" 
                        class="btn-filtro-atalho @(filtroRapido == "todos" ? "active" : "")"
                        @onclick='() => AplicarFiltroRapido("todos")'>
                    Todos
                </button>
            </div>
        </div>

        <!-- Painel de Intervalo Personalizado -->
        @if (filtroRapido == "personalizado")
        {
            <div class="painel-personalizado">
                <div class="custom-date-group">
                    <label class="filtro-label">Data Inicial:</label>
                    <input type="date" class="date-input" @bind="dataInicioPersonalizada" />
                </div>
                <div class="custom-date-group">
                    <label class="filtro-label">Data Final:</label>
                    <input type="date" class="date-input" @bind="dataFimPersonalizada" />
                </div>
                <button type="button" class="btn-aplicar-periodo" @onclick="CarregarValidades">
                    Aplicar Intervalo
                </button>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(feedbackToast))
    {
        <div class="feedback-toast">
            <span>@feedbackToast</span>
        </div>
    }

    <!-- Listagem Ordenada por Vencimento -->
    <div class="listagem-card">
        <div class="listagem-header">
            <div class="listagem-titles-area">
                <h2 class="listagem-title">
                    Itens em Monitoramento (@TotalItensFiltrados)
                    @if (!string.IsNullOrWhiteSpace(termoBusca))
                    {
                        <span class="filtro-termo-aviso">(filtrado de @validades.Count)</span>
                    }
                </h2>
                <span class="listagem-ordem">Ordenado pelas validades mais próximas primeiro</span>
            </div>

            <!-- Toolbar de Busca Rápida e Itens por Página -->
            <div class="paginacao-topo-toolbar">
                <div class="busca-input-wrapper">
                    <span class="busca-lupa-icon">🔍</span>
                    <input type="text" 
                           class="input-busca-produtos" 
                           placeholder="Buscar por produto ou código..." 
                           value="@termoBusca" 
                           @oninput="OnBuscaInput" />
                    @if (!string.IsNullOrWhiteSpace(termoBusca))
                    {
                        <button type="button" class="btn-limpar-busca-rapida" @onclick="LimparBusca" title="Limpar busca">×</button>
                    }
                </div>

                <div class="toolbar-controles-direita">
                    <div class="view-mode-toggle" title="Alternar formato de visualização">
                        <button type="button" 
                                class="btn-toggle-view @(modoVisualizacao == "tabela" ? "active" : "")" 
                                @onclick='() => SetModoVisualizacao("tabela")'
                                title="Visualizar em Tabela Detalhada">
                            ☰ Tabela
                        </button>
                        <button type="button" 
                                class="btn-toggle-view @(modoVisualizacao == "cards" ? "active" : "")" 
                                @onclick='() => SetModoVisualizacao("cards")'
                                title="Visualizar em Cartões">
                            ⊞ Cartões
                        </button>
                    </div>

                    <div class="seletor-limite-wrapper">
                        <span class="limite-label">Exibir:</span>
                        <select class="select-limite-pagina" value="@itensPorPagina" @onchange="OnItensPorPaginaAlterado">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="250">250</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        @if (carregando)
        {
            <div class="carregando-box">Carregando lotes de validade...</div>
        }
        else if (validades.Count == 0)
        {
            <div class="empty-box">
                <span class="empty-icon">🎉</span>
                <h3>Nenhum lote encontrado para este filtro!</h3>
                <p>Todos os produtos estão em dia ou não há lotes ativos no período selecionado.</p>
                <button type="button" class="btn-limpar-filtros" @onclick='() => AplicarFiltroRapido("todos")'>
                    Ver Todos os Lotes Ativos
                </button>
            </div>
        }
        else if (TotalItensFiltrados == 0)
        {
            <div class="empty-box">
                <span class="empty-icon">🔍</span>
                <h3>Nenhum produto encontrado para "@termoBusca"</h3>
                <p>Verifique o nome digitado ou código de barras.</p>
                <button type="button" class="btn-limpar-filtros" @onclick="LimparBusca">
                    Limpar Filtro de Busca
                </button>
            </div>
        }
        else
        {
            <!-- Visualização em Tabela Responsiva / Desktop -->
            <div class="table-responsive-desktop @(modoVisualizacao == "tabela" ? "view-active" : "view-hidden")">
                <table class="tabela-monitoramento">
                    <thead>
                        <tr>
                            <th class="col-th-checkbox">
                                <input type="checkbox" 
                                       class="checkbox-custom-item" 
                                       checked="@TodosDaPaginaSelecionados" 
                                       @onchange="ToggleSelecionarTodosDaPagina" 
                                       title="Selecionar / Desmarcar todos da página atual" />
                            </th>
                            <th class="col-th-loja">Loja</th>
                            <th class="col-th-codigo">Código</th>
                            <th class="col-th-produto">Nome do Produto</th>
                            <th class="col-th-validade">Validade & Prazo</th>
                            <th class="col-th-coleta">Data Coleta</th>
                            <th class="col-th-promocao">Promoção</th>
                            <th class="col-th-acoes">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ItensPaginados)
                        {
                            <tr class="item-row @(itensSelecionadosIds.Contains(item.Id) ? "row-selected" : "") @(item.EstaVencido ? "row-alerta-vencido" : (item.DiasRestantes <= 7 ? "row-destaque-7dias" : ""))">
                                <td class="col-td-checkbox">
                                    <input type="checkbox" 
                                           class="checkbox-custom-item" 
                                           checked="@itensSelecionadosIds.Contains(item.Id)" 
                                           @onchange="(e) => ToggleItemSelecionado(item.Id, (bool)(e.Value ?? false))" />
                                </td>
                                <td class="col-td-loja">
                                    <span class="loja-chip" title="@(item.Loja?.Nome ?? "Loja")">
                                        @ObterNomeLojaReduzido(item.Loja)
                                    </span>
                                </td>
                                <td class="col-td-codigo">
                                    <code class="codigo-barras-cell">@(item.Produto?.CodigoBarras ?? "-")</code>
                                </td>
                                <td class="col-td-produto">
                                    <div class="prod-nome-wrapper">
                                        @if (item.EstaVencido)
                                        {
                                            <span class="icone-alerta-linha" title="Produto Vencido">🚨</span>
                                        }
                                        else if (item.DiasRestantes <= 7)
                                        {
                                            <span class="icone-alerta-linha" title="Próximo de vencer (até 7 dias)">⚠️</span>
                                        }
                                        <strong class="produto-nome-cell" title="@(item.Produto?.Nome ?? "-")">@(item.Produto?.Nome ?? "-")</strong>
                                    </div>
                                </td>
                                <td class="col-td-validade">
                                    <div class="validade-cell-group">
                                        <span class="validade-data-destaque @(item.EstaVencido ? "data-vencida" : (item.DiasRestantes <= 7 ? "data-destaque-7dias" : ""))">
                                            @item.DataValidade.ToString("dd/MM/yyyy")
                                        </span>
                                        @if (item.EstaVencido)
                                        {
                                            <span class="badge-prazo-tag badge-vencido">
                                                🚨 Vencido há @Math.Abs(item.DiasRestantes) @(Math.Abs(item.DiasRestantes) == 1 ? "dia" : "dias")
                                            </span>
                                        }
                                        else if (item.DiasRestantes == 0)
                                        {
                                            <span class="badge-prazo-tag badge-hoje">
                                                ⚠️ Vence HOJE!
                                            </span>
                                        }
                                        else if (item.DiasRestantes == 1)
                                        {
                                            <span class="badge-prazo-tag badge-amanha">
                                                ⏳ Vence amanhã!
                                            </span>
                                        }
                                        else if (item.DiasRestantes <= 7)
                                        {
                                            <span class="badge-prazo-tag badge-7dias">
                                                ⏳ Vence em @item.DiasRestantes dias
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="prazo-auxiliar">
                                                @item.MensagemPrazo
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="col-td-coleta">
                                    <span class="data-coleta-cell">@item.DataColeta.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td class="col-td-promocao">
                                    <label class="switch-promocao" title="Clique para alternar status de promoção">
                                        <input type="checkbox" 
                                               checked="@item.EmPromocao" 
                                               @onchange="(e) => TogglePromocao(item, (bool)e.Value!)" />
                                        <span class="switch-slider"></span>
                                        <span class="switch-label @(item.EmPromocao ? "promo-ativa-txt" : "promo-inativa-txt")">
                                            @(item.EmPromocao ? "Sim" : "Não")
                                        </span>
                                    </label>
                                </td>
                                <td class="col-td-acoes">
                                    <div class="table-acoes-group">
                                        <button type="button" 
                                                class="btn-whatsapp-mini" 
                                                title="Compartilhar via WhatsApp"
                                                @onclick="() => CompartilharItemIndividual(item)">
                                            💬
                                        </button>
                                        <button type="button" 
                                                class="btn-editar-mini" 
                                                title="Dar Baixa / Editar lote"
                                                @onclick="() => AbrirModalBaixa(item)">
                                            ✏️
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Visualização em Cards (Mobile e Grid Responsiva) -->
            <div class="cards-view-wrapper @(modoVisualizacao == "cards" ? "view-active" : "view-hidden")">
                <div class="mobile-selecao-header">
                    <label class="checkbox-label-mobile">
                        <input type="checkbox" 
                               class="checkbox-custom-item" 
                               checked="@TodosCardsDaPaginaSelecionados" 
                               @onchange="ToggleSelecionarTodosCardsDaPagina" />
                        <span>Selecionar todos da página (@GruposCardsPaginados.Count produtos)</span>
                    </label>
                </div>

                <div class="cards-responsive-grid">
                    @foreach (var grupo in GruposCardsPaginados)
                    {
                        var itemAtivo = ObterLoteAtivo(grupo);
                        <div class="mobile-item-card @(itensSelecionadosIds.Contains(itemAtivo.Id) ? "card-selected" : "") @(itemAtivo.EstaVencido ? "card-alerta-vencido" : (itemAtivo.DiasRestantes <= 7 ? "card-destaque-7dias" : ""))">
                            <div class="card-topo">
                                <div class="card-topo-left">
                                    <input type="checkbox" 
                                           class="checkbox-custom-item" 
                                           checked="@itensSelecionadosIds.Contains(itemAtivo.Id)" 
                                           @onchange="(e) => ToggleItemSelecionado(itemAtivo.Id, (bool)(e.Value ?? false))" />
                                    <span class="loja-chip" title="@(grupo.Loja?.Nome ?? "Loja")">
                                        @ObterNomeLojaReduzido(grupo.Loja)
                                    </span>
                                </div>
                                <div class="card-topo-badges">
                                    @if (grupo.Validades.Count > 1)
                                    {
                                        <span class="badge-qtd-lotes" title="Este produto possui @grupo.Validades.Count validades cadastradas">
                                            📦 @grupo.Validades.Count validades
                                        </span>
                                    }
                                    @if (itemAtivo.EstaVencido)
                                    {
                                        <span class="status-chip chip-vencido">🚨 VENCIDO</span>
                                    }
                                    else if (itemAtivo.DiasRestantes == 0)
                                    {
                                        <span class="status-chip chip-hoje">⚠️ VENCE HOJE</span>
                                    }
                                    else if (itemAtivo.DiasRestantes <= 7)
                                    {
                                        <span class="status-chip chip-atencao">⏳ @itemAtivo.DiasRestantes dias</span>
                                    }
                                    else
                                    {
                                        <span class="status-chip chip-ok">@itemAtivo.DiasRestantes dias</span>
                                    }
                                </div>
                            </div>

                            <h3 class="card-prod-nome">
                                @if (itemAtivo.EstaVencido)
                                {
                                    <span style="color: #dc2626;">🚨 </span>
                                }
                                else if (itemAtivo.DiasRestantes <= 7)
                                {
                                    <span style="color: #d97706;">⚠️ </span>
                                }
                                @(grupo.Produto?.Nome ?? "-")
                            </h3>
                            <span class="card-barcode">Código: @(grupo.Produto?.CodigoBarras ?? "-")</span>

                            @if (grupo.Validades.Count > 1)
                            {
                                <div class="seletor-lotes-container">
                                    <div class="seletor-lotes-header">
                                        <span class="seletor-lotes-lbl">Validade Selecionada para Ação:</span>
                                        <span class="seletor-lotes-count">(@grupo.Validades.Count disponíveis)</span>
                                    </div>
                                    <div class="chips-lotes-grid">
                                        @foreach (var val in grupo.Validades)
                                        {
                                            var isSel = (val.Id == itemAtivo.Id);
                                            <button type="button" 
                                                    class="btn-chip-lote @(isSel ? "lote-ativo" : "") @(val.EstaVencido ? "lote-vencido" : (val.DiasRestantes <= 7 ? "lote-urgente" : ""))"
                                                    @onclick="() => SelecionarLote(grupo.Chave, val.Id)"
                                                    title="Clique para selecionar e agir sobre a validade @val.DataValidade.ToString("dd/MM/yyyy")">
                                                <span class="chip-lote-radio">@(isSel ? "●" : "○")</span>
                                                <strong class="chip-lote-data">@val.DataValidade.ToString("dd/MM/yyyy")</strong>
                                                <span class="chip-lote-prazo">(@val.MensagemPrazo)</span>
                                                @if (val.EmPromocao)
                                                {
                                                    <span class="chip-lote-promo-badge">Promo</span>
                                                }
                                            </button>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="card-datas-grid">
                                <div class="data-bloco">
                                    <span class="data-label">@(grupo.Validades.Count > 1 ? "Validade em Foco" : "Validade")</span>
                                    <span class="data-val @(itemAtivo.EstaVencido ? "data-vencida" : (itemAtivo.DiasRestantes <= 7 ? "data-destaque-7dias" : ""))">
                                        @itemAtivo.DataValidade.ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                                <div class="data-bloco">
                                    <span class="data-label">Data Coleta</span>
                                    <span class="data-val">@itemAtivo.DataColeta.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>

                            <div class="card-prazo-aviso @(itemAtivo.EstaVencido ? "prazo-vencido-destaque" : (itemAtivo.DiasRestantes <= 7 ? "prazo-7dias-destaque" : ""))">
                                @itemAtivo.MensagemPrazo
                            </div>

                            <div class="card-rodape">
                                <div class="card-promocao-row">
                                    <label class="switch-promocao" title="Alternar status de promoção da validade selecionada">
                                        <input type="checkbox" 
                                               checked="@itemAtivo.EmPromocao" 
                                               @onchange="(e) => TogglePromocao(itemAtivo, (bool)(e.Value ?? false))" />
                                        <span class="switch-slider"></span>
                                        <span class="switch-label @(itemAtivo.EmPromocao ? "promo-ativa-txt" : "promo-inativa-txt")">
                                            @(itemAtivo.EmPromocao ? "Item em Promoção (Sim)" : "Item em Promoção (Não)")
                                        </span>
                                    </label>
                                </div>

                                <div class="card-acoes-grid">
                                    <button type="button" class="btn-whatsapp-card btn-mobile-acao" @onclick="() => CompartilharItemIndividual(itemAtivo)" title="Enviar validade selecionada via WhatsApp">
                                        💬 WhatsApp
                                    </button>
                                    <button type="button" class="btn-dar-baixa btn-mobile-acao" @onclick="() => AbrirModalBaixa(itemAtivo)" title="Dar baixa na validade @itemAtivo.DataValidade.ToString("dd/MM/yyyy")">
                                        ✏️ Dar Baixa
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Barra de Navegação de Paginação -->
            @if (TotalPaginas > 1)
            {
                <div class="paginacao-rodape">
                    <div class="paginacao-info">
                        Exibindo <strong>@PrimeiroItemExibido</strong> a <strong>@UltimoItemExibido</strong> de <strong>@TotalContagemModoAtual</strong> @(modoVisualizacao == "cards" ? "produtos" : "lotes")
                    </div>

                    <div class="paginacao-botoes">
                        <button type="button" 
                                class="btn-nav-page" 
                                disabled="@(paginaAtual <= 1)" 
                                @onclick="() => IrParaPagina(1)" 
                                title="Primeira Página">
                            ⏮
                        </button>
                        <button type="button" 
                                class="btn-nav-page" 
                                disabled="@(paginaAtual <= 1)" 
                                @onclick="PaginaAnterior" 
                                title="Página Anterior">
                            ◀ Anterior
                        </button>

                        @foreach (var p in ObterPaginasVisiveis())
                        {
                            <button type="button" 
                                    class="btn-nav-page btn-num-page @(p == paginaAtual ? "active" : "")" 
                                    @onclick="() => IrParaPagina(p)">
                                @p
                            </button>
                        }

                        <button type="button" 
                                class="btn-nav-page" 
                                disabled="@(paginaAtual >= TotalPaginas)" 
                                @onclick="ProximaPagina" 
                                title="Próxima Página">
                            Próxima ▶
                        </button>
                        <button type="button" 
                                class="btn-nav-page" 
                                disabled="@(paginaAtual >= TotalPaginas)" 
                                @onclick="() => IrParaPagina(TotalPaginas)" 
                                title="Última Página">
                            ⏭
                        </button>
                    </div>
                </div>
            }

            <!-- Barra Flutuante de Ações para Itens Selecionados -->
            @if (itensSelecionadosIds.Any())
            {
                <div class="barra-flutuante-selecao">
                    <div class="barra-flutuante-info">
                        <span class="barra-contador">@itensSelecionadosIds.Count</span>
                        <span class="barra-texto">item(ns) selecionado(s)</span>
                    </div>
                    <div class="barra-flutuante-acoes">
                        <button type="button" class="btn-barra-whatsapp" @onclick="AbrirModalCompartilharSelecionados">
                            💬 Enviar WhatsApp
                        </button>
                        <button type="button" class="btn-barra-copiar" @onclick="CopiarSelecionadosRapido" title="Copiar texto para área de transferência">
                            📋 Copiar Texto
                        </button>
                        <button type="button" class="btn-barra-desmarcar" @onclick="DesmarcarTodos">
                            ✕ Desmarcar
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Modal de Compartilhamento via WhatsApp -->
<ModalCompartilharWhatsApp IsVisible="exibirModalWhatsApp"
                           Itens="itensParaCompartilhar"
                           NomeLoja="@NomeLojaAtual"
                           NomeLojaPadrao="@NomeLojaAtual"
                           OnFechar="FecharModalWhatsApp" />

<!-- Modal de Baixa de Validade -->
<ModalBaixa IsVisible="exibirModalBaixa"
            Registro="itemParaBaixa"
            OnConfirmar="ConfirmarBaixa"
            OnCancelar="FecharModalBaixa" />

@code {
    private List<Loja> lojas = new();
    private int lojaFiltroId = 0; // 0 = Todas as Lojas
    private string filtroRapido = "todos"; // 7dias, 10dias, 15dias, vencidos, personalizado, todos
    private DateTime dataInicioPersonalizada = DateTime.Today;
    private DateTime dataFimPersonalizada = DateTime.Today.AddDays(30);

    private List<RegistroValidade> validades = new();
    private bool carregando = true;

    // Seleção de Itens e Compartilhamento WhatsApp
    private HashSet<int> itensSelecionadosIds = new();
    private bool exibirModalWhatsApp = false;
    private List<RegistroValidade> itensParaCompartilhar = new();

    // Modo de Visualização (Tabela vs Cartões)
    private string modoVisualizacao = "tabela";

    // Modelo para agrupamento de validades do mesmo produto na mesma loja (Cards)
    public class GrupoProdutoValidade
    {
        public string Chave => $"{LojaId}_{ProdutoId}";
        public int LojaId { get; set; }
        public int ProdutoId { get; set; }
        public Produto? Produto { get; set; }
        public Loja? Loja { get; set; }
        public List<RegistroValidade> Validades { get; set; } = new();
        public RegistroValidade ValidadeMaisUrgente =>
            Validades.OrderBy(v => v.DataValidade).FirstOrDefault() ?? Validades.First();
    }

    private Dictionary<string, int> loteSelecionadoPorGrupo = new();

    private RegistroValidade ObterLoteAtivo(GrupoProdutoValidade grupo)
    {
        if (loteSelecionadoPorGrupo.TryGetValue(grupo.Chave, out var idAtivo))
        {
            var encontrado = grupo.Validades.FirstOrDefault(v => v.Id == idAtivo);
            if (encontrado != null) return encontrado;
        }
        return grupo.ValidadeMaisUrgente;
    }

    private void SelecionarLote(string chaveGrupo, int validadeId)
    {
        loteSelecionadoPorGrupo[chaveGrupo] = validadeId;
    }

    private void SetModoVisualizacao(string modo)
    {
        modoVisualizacao = modo;
        paginaAtual = 1;
    }

    private string ObterNomeLojaReduzido(Loja? loja)
    {
        if (loja == null) return "Loja";
        if (!string.IsNullOrWhiteSpace(loja.CodigoLoja)) return loja.CodigoLoja;
        return ObterNomeLojaReduzido(loja.Nome);
    }

    private string ObterNomeLojaReduzido(string? nome)
    {
        if (string.IsNullOrWhiteSpace(nome)) return "Loja";
        var limpo = nome.Trim();
        if (limpo.StartsWith("Loja ", StringComparison.OrdinalIgnoreCase) && limpo.Length > 5)
        {
            var semPrefixo = limpo.Substring(5).Trim();
            if (int.TryParse(semPrefixo, out _))
                return $"Lj. {semPrefixo}";
            return semPrefixo;
        }
        return limpo;
    }

    // Paginação e Busca Instantânea
    private int paginaAtual = 1;
    private int itensPorPagina = 50;
    private string termoBusca = string.Empty;

    private IEnumerable<RegistroValidade> ItensFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(termoBusca))
                return validades;

            var b = termoBusca.Trim().ToLowerInvariant();
            return validades.Where(v =>
                (v.Produto?.Nome != null && v.Produto.Nome.ToLowerInvariant().Contains(b)) ||
                (v.Produto?.CodigoBarras != null && v.Produto.CodigoBarras.Contains(b)) ||
                (v.Loja?.Nome != null && v.Loja.Nome.ToLowerInvariant().Contains(b))
            );
        }
    }

    private int TotalItensFiltrados => ItensFiltrados.Count();

    private IEnumerable<GrupoProdutoValidade> GruposCardsFiltrados
    {
        get
        {
            return ItensFiltrados
                .GroupBy(v => new { v.ProdutoId, v.LojaId })
                .Select(g => new GrupoProdutoValidade
                {
                    LojaId = g.Key.LojaId,
                    ProdutoId = g.Key.ProdutoId,
                    Produto = g.First().Produto,
                    Loja = g.First().Loja,
                    Validades = g.OrderBy(v => v.DataValidade).ToList()
                })
                .OrderBy(g => g.ValidadeMaisUrgente.DataValidade);
        }
    }

    private int TotalGruposFiltrados => GruposCardsFiltrados.Count();

    private List<GrupoProdutoValidade> GruposCardsPaginados =>
        GruposCardsFiltrados
            .Skip((paginaAtual - 1) * itensPorPagina)
            .Take(itensPorPagina)
            .ToList();

    private bool TodosCardsDaPaginaSelecionados
    {
        get
        {
            var ativos = GruposCardsPaginados.Select(g => ObterLoteAtivo(g)).ToList();
            return ativos.Any() && ativos.All(i => itensSelecionadosIds.Contains(i.Id));
        }
    }

    private void ToggleSelecionarTodosCardsDaPagina(ChangeEventArgs e)
    {
        bool selecionar = (bool)(e.Value ?? false);
        var idsAtivos = GruposCardsPaginados.Select(g => ObterLoteAtivo(g).Id).ToList();

        if (selecionar)
        {
            foreach (var id in idsAtivos)
                itensSelecionadosIds.Add(id);
        }
        else
        {
            foreach (var id in idsAtivos)
                itensSelecionadosIds.Remove(id);
        }
    }

    private int TotalContagemModoAtual => modoVisualizacao == "cards" ? TotalGruposFiltrados : TotalItensFiltrados;
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling((double)TotalContagemModoAtual / itensPorPagina));
    private int PrimeiroItemExibido => TotalContagemModoAtual == 0 ? 0 : ((paginaAtual - 1) * itensPorPagina) + 1;
    private int UltimoItemExibido => Math.Min(paginaAtual * itensPorPagina, TotalContagemModoAtual);

    private List<RegistroValidade> ItensPaginados =>
        ItensFiltrados
            .Skip((paginaAtual - 1) * itensPorPagina)
            .Take(itensPorPagina)
            .ToList();

    private void IrParaPagina(int p)
    {
        paginaAtual = Math.Clamp(p, 1, TotalPaginas);
    }

    private void PaginaAnterior()
    {
        if (paginaAtual > 1) paginaAtual--;
    }

    private void ProximaPagina()
    {
        if (paginaAtual < TotalPaginas) paginaAtual++;
    }

    private void OnItensPorPaginaAlterado(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var novo))
        {
            itensPorPagina = novo;
            paginaAtual = 1;
        }
    }

    private void OnBuscaInput(ChangeEventArgs e)
    {
        termoBusca = e.Value?.ToString() ?? string.Empty;
        paginaAtual = 1;
    }

    private void LimparBusca()
    {
        termoBusca = string.Empty;
        paginaAtual = 1;
    }

    private IEnumerable<int> ObterPaginasVisiveis()
    {
        int delta = 1;
        int inicio = Math.Max(1, paginaAtual - delta);
        int fim = Math.Min(TotalPaginas, paginaAtual + delta);

        if (fim - inicio < 2)
        {
            if (inicio == 1)
                fim = Math.Min(TotalPaginas, inicio + 2);
            else if (fim == TotalPaginas)
                inicio = Math.Max(1, fim - 2);
        }

        for (int i = inicio; i <= fim; i++)
        {
            yield return i;
        }
    }

    // Toast feedback
    private string feedbackToast = string.Empty;

    // Modal Baixa
    private bool exibirModalBaixa = false;
    private RegistroValidade? itemParaBaixa = null;

    protected override async Task OnInitializedAsync()
    {
        lojas = await ValidadeService.GetLojasAsync();
        await CarregarValidades();
    }

    private async Task CarregarValidades()
    {
        carregando = true;
        paginaAtual = 1;
        itensSelecionadosIds.Clear();
        loteSelecionadoPorGrupo.Clear();
        int? lojaId = lojaFiltroId > 0 ? lojaFiltroId : null;

        validades = await ValidadeService.GetValidadesAtivasAsync(
            lojaId,
            filtroRapido,
            dataInicioPersonalizada,
            dataFimPersonalizada
        );

        carregando = false;
    }

    private async Task AplicarFiltroRapido(string filtro)
    {
        filtroRapido = filtro;
        paginaAtual = 1;
        await CarregarValidades();
    }

    private async Task TogglePromocao(RegistroValidade item, bool novoStatus)
    {
        item.EmPromocao = novoStatus;
        await ValidadeService.AlternarPromocaoAsync(item.Id, novoStatus);

        feedbackToast = $"Promoção de '{item.Produto?.Nome}' atualizada para: {(novoStatus ? "Sim" : "Não")}.";
        _ = Task.Run(async () =>
        {
            await Task.Delay(2500);
            feedbackToast = string.Empty;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void AbrirModalBaixa(RegistroValidade item)
    {
        itemParaBaixa = item;
        exibirModalBaixa = true;
    }

    private void FecharModalBaixa()
    {
        exibirModalBaixa = false;
        itemParaBaixa = null;
    }

    private async Task ConfirmarBaixa(string motivo)
    {
        if (itemParaBaixa != null)
        {
            await ValidadeService.DarBaixaAsync(itemParaBaixa.Id, motivo);
            feedbackToast = $"Baixa efetuada com sucesso para '{itemParaBaixa.Produto?.Nome}' (Motivo: {motivo})!";
            await CarregarValidades();
        }
        FecharModalBaixa();
    }

    // Métodos de Seleção e WhatsApp
    private bool TodosDaPaginaSelecionados =>
        ItensPaginados.Any() && ItensPaginados.All(i => itensSelecionadosIds.Contains(i.Id));

    private void ToggleItemSelecionado(int id, bool selecionado)
    {
        if (selecionado)
            itensSelecionadosIds.Add(id);
        else
            itensSelecionadosIds.Remove(id);
    }

    private void ToggleSelecionarTodosDaPagina(ChangeEventArgs e)
    {
        bool selecionar = (bool)(e.Value ?? false);
        var idsPagina = ItensPaginados.Select(i => i.Id).ToList();

        if (selecionar)
        {
            foreach (var id in idsPagina)
                itensSelecionadosIds.Add(id);
        }
        else
        {
            foreach (var id in idsPagina)
                itensSelecionadosIds.Remove(id);
        }
    }

    private void DesmarcarTodos()
    {
        itensSelecionadosIds.Clear();
    }

    private string NomeLojaAtual =>
        lojaFiltroId > 0 
            ? (lojas.FirstOrDefault(l => l.Id == lojaFiltroId)?.Nome ?? "Loja") 
            : "Todas as Lojas";

    private void CompartilharItemIndividual(RegistroValidade item)
    {
        itensParaCompartilhar = new List<RegistroValidade> { item };
        exibirModalWhatsApp = true;
    }

    private void AbrirModalCompartilharSelecionados()
    {
        if (!itensSelecionadosIds.Any()) return;
        itensParaCompartilhar = validades.Where(v => itensSelecionadosIds.Contains(v.Id)).ToList();
        exibirModalWhatsApp = true;
    }

    private void FecharModalWhatsApp()
    {
        exibirModalWhatsApp = false;
        itensParaCompartilhar = new();
    }

    private async Task CopiarSelecionadosRapido()
    {
        if (!itensSelecionadosIds.Any()) return;
        var selecionados = validades.Where(v => itensSelecionadosIds.Contains(v.Id)).ToList();

        var linhas = selecionados.Select(v => 
            $"{v.Produto?.CodigoBarras ?? "-"} {v.Produto?.Nome ?? "Produto"} {v.DataValidade:dd/MM/yyyy}");
        var texto = string.Join("\n", linhas);

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", texto);
            feedbackToast = $"📋 {selecionados.Count} produto(s) copiado(s) para a área de transferência!";
        }
        catch
        {
            feedbackToast = "Não foi possível copiar automaticamente. Use a opção Enviar WhatsApp para ver o texto.";
        }

        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            feedbackToast = string.Empty;
            await InvokeAsync(StateHasChanged);
        });
    }
}
