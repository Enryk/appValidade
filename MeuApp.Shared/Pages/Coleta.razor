@page "/coleta"
@namespace MeuApp.Shared.Pages
@inject IValidadeService ValidadeService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="coleta-page">
    <!-- Topo Oficial ValiData: Seta Voltar, Título "Coleta" e Ícone de Câmera -->
    <header class="coleta-top-bar">
        <button type="button" class="btn-circular-voltar" @onclick="TentarVoltar" aria-label="Voltar" title="Voltar">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </button>

        <h1 class="coleta-top-title">Coleta</h1>

        <button type="button" class="btn-camera-scanner" @onclick="AbrirScannerCamera" aria-label="Abrir Câmera" title="Abrir Câmera para Leitura de Código de Barras">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                <circle cx="12" cy="13" r="4"></circle>
            </svg>
        </button>
    </header>

    <!-- Campo de Busca com Auto-busca Instantânea por EAN -->
    <section class="busca-section">
        <div class="busca-input-box">
            <span class="busca-icon">🔍</span>
            <input type="text"
                   inputmode="numeric"
                   class="input-busca-ean"
                   placeholder="Pesquisar código de barras (EAN)..."
                   value="@codigoBarrasInput"
                   @oninput="OnBuscaInputAlterado"
                   autofocus />
            @if (!string.IsNullOrEmpty(codigoBarrasInput))
            {
                <button type="button" class="btn-limpar-busca" @onclick="LimparBusca" title="Limpar busca">×</button>
            }
            <span class="barcode-decor-icon" title="Código de Barras">║▌║</span>
        </div>

        @* Seletor de Loja Compacto *@
        @if (lojas.Any())
        {
            <div class="loja-selector-chip">
                <span class="loja-label">Loja:</span>
                <select class="select-loja-compact" @bind="lojaSelecionadaId" @bind:after="OnLojaAlterada">
                    @foreach (var loja in lojas)
                    {
                        <option value="@loja.Id">@loja.Nome (@(!string.IsNullOrWhiteSpace(loja.CodigoLoja) ? loja.CodigoLoja : $"LJ-{loja.Id}"))</option>
                    }
                </select>
                <span class="select-arrow">▾</span>
            </div>
        }
    </section>

    @* Banner de Notificação / Feedback *@
    @if (!string.IsNullOrEmpty(feedbackMensagem))
    {
        <div class="alert-banner @(feedbackTipo == "success" ? "alert-success" : (feedbackTipo == "warning" ? "alert-warning" : "alert-info"))">
            <span>@feedbackMensagem</span>
            <button type="button" class="btn-close-alert" @onclick="() => feedbackMensagem = string.Empty">×</button>
        </div>
    }

    @* Nenhuma Loja Cadastrada *@
    @if (!lojas.Any())
    {
        <div class="empty-state-card">
            <span class="empty-icon">🏬</span>
            <h2>Nenhuma Loja Cadastrada</h2>
            <p>Para começar a bipar produtos e registrar validades, cadastre a sua primeira filial em Gestão de Lojas.</p>
            <a href="lojas" class="btn-ir-lojas">🏬 Cadastrar Loja</a>
        </div>
    }
    else
    {
        @* Área de Resultados da Auto-Busca ou Produto Ativo *@
        @if (!string.IsNullOrWhiteSpace(codigoBarrasInput))
        {
            <section class="resultados-autobusca">
                @if (carregandoBusca)
                {
                    <div class="busca-carregando">
                        <span class="spinner-sm"></span> Buscando produtos no catálogo...
                    </div>
                }
                else if (produtosEncontrados.Any())
                {
                    <div class="produtos-lista-grid">
                        @foreach (var prod in produtosEncontrados)
                        {
                            var lotesLoja = prod.Validades?.Where(v => v.LojaId == lojaSelecionadaId && v.Status == "Ativo").ToList() ?? new();
                            <div class="card-produto-resultado">
                                <div class="card-produto-info">
                                    <div class="produto-topo-linha">
                                        <h3 class="prod-nome">@prod.Nome</h3>
                                        <code class="chip-ean">@prod.CodigoBarras</code>
                                    </div>

                                    @if (lotesLoja.Any())
                                    {
                                        <div class="lotes-existentes-row">
                                            <span class="lotes-label">Lotes ativos nesta loja:</span>
                                            @foreach (var lote in lotesLoja)
                                            {
                                                <span class="chip-lote-data @(lote.EstaVencido ? "lote-vencido" : "")">
                                                    @lote.DataValidade.ToString("dd/MM/yyyy")
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="card-produto-acoes">
                                    <button type="button" class="btn-add-validade" @onclick="() => IniciarRegistroValidade(prod)">
                                        + Validade
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="card-produto-nao-encontrado">
                        <div class="nao-encontrado-header">
                            <span class="nao-encontrado-icon">📦</span>
                            <div>
                                <h4>Código "@codigoBarrasInput" não cadastrado</h4>
                                <p>Este produto é inédito no catálogo da rede. Cadastre o nome para incluí-lo.</p>
                            </div>
                        </div>
                        <button type="button" class="btn-cadastrar-inedito" @onclick="IniciarCadastroInedito">
                            ➕ Cadastrar Produto e Validade
                        </button>
                    </div>
                }
            </section>
        }

        @* Formulário de Inclusão de Validade (Para Produto Selecionado ou Inédito) *@
        @if (exibirFormularioRegistro && produtoAlvo != null)
        {
            <section class="modal-backdrop-interno" @onclick="FecharFormularioRegistro">
                <div class="modal-registro-card" @onclick:stopPropagation="true">
                    <div class="modal-registro-header">
                        <div>
                            <span class="registro-tag">@(modoInedito ? "Novo Produto no Catálogo" : "Registrar Validade")</span>
                            <h3 class="registro-prod-nome">@(modoInedito ? "Cadastro de Novo Produto" : produtoAlvo.Nome)</h3>
                            <code class="registro-ean">EAN: @produtoAlvo.CodigoBarras</code>
                        </div>
                        <button type="button" class="btn-fechar-modal" @onclick="FecharFormularioRegistro">×</button>
                    </div>

                    <div class="modal-registro-body">
                        @if (modoInedito)
                        {
                            <div class="form-campo">
                                <label class="campo-label">Nome do Produto: *</label>
                                <input type="text"
                                       class="form-input-custom"
                                       placeholder="Ex: Leite Integral 1L"
                                       @bind="novoProdutoNome" />
                            </div>
                        }

                        <div class="form-campo">
                            <label class="campo-label">Data de Validade: *</label>
                            <input type="date"
                                   class="form-input-custom"
                                   @bind="novaDataValidade" />
                        </div>

                        <div class="form-campo-check">
                            <label class="checkbox-custom-label">
                                <input type="checkbox" @bind="novoLoteEmPromocao" />
                                <span>Item em promoção de validade</span>
                            </label>
                        </div>

                        <div class="lojas-alvo-box">
                            <div class="lojas-alvo-topo">
                                <label class="campo-label">Lojas para salvar:</label>
                                <button type="button"
                                        class="btn-selecionar-todas @(TodasLojasSelecionadas ? "todas-ativas" : "")"
                                        @onclick="AlternarSelecionarTodasLojas">
                                    @(TodasLojasSelecionadas ? "✓ Todas Selecionadas" : "☐ Selecionar TODAS")
                                </button>
                            </div>
                            <div class="chips-lojas-grid">
                                @foreach (var loja in lojas)
                                {
                                    var isSel = lojasAlvoIds.Contains(loja.Id);
                                    <label class="chip-loja-check @(isSel ? "chip-loja-sel" : "")">
                                        <input type="checkbox"
                                               checked="@isSel"
                                               @onchange="(e) => ToggleLojaAlvo(loja.Id, (bool)e.Value!)" />
                                        <span>@loja.Nome</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="modal-registro-footer">
                        <button type="button" class="btn-cancelar-modal" @onclick="FecharFormularioRegistro">
                            Cancelar
                        </button>
                        <button type="button" class="btn-salvar-lote-sessao" @onclick="ConfirmarAdicionarLoteSessao">
                            ➕ Adicionar à Coleta
                        </button>
                    </div>
                </div>
            </section>
        }

        @* Sessão de Itens Já Coletados *@
        @if (coletasSessao.Any())
        {
            <section class="sessao-coletados-container">
                <div class="sessao-header">
                    <h2 class="sessao-titulo">Itens Coletados nesta Sessão (@coletasSessao.Count)</h2>
                    <span class="sessao-sub">Prontos para serem salvos</span>
                </div>

                <div class="lista-coletados-grid">
                    @foreach (var item in coletasSessao)
                    {
                        <div class="item-coletado-card">
                            <div class="item-coletado-info">
                                <strong class="item-coletado-nome">@item.NomeProduto</strong>
                                <div class="item-coletado-detalhes">
                                    <code class="chip-ean-sm">@item.CodigoBarras</code>
                                    <span class="chip-loja-sm">@item.LojaSigla</span>
                                    <span class="badge-validade-sm">📅 @item.DataValidade.ToString("dd/MM/yyyy")</span>
                                    @if (item.EmPromocao)
                                    {
                                        <span class="badge-promo-sm">Promo</span>
                                    }
                                </div>
                            </div>
                            <button type="button" class="btn-remover-item-sessao" @onclick="() => RemoverItemSessao(item)" title="Remover item da sessão">
                                🗑️
                            </button>
                        </div>
                    }
                </div>
            </section>
        }

        @* Barra Flutuante Inferior de Finalização *@
        @if (coletasSessao.Any())
        {
            <div class="floating-coleta-bar">
                <div class="floating-bar-content">
                    <div class="floating-info">
                        <span class="floating-count">@coletasSessao.Count</span>
                        <span class="floating-text">item(ns) coletados nesta sessão</span>
                    </div>
                    <button type="button" class="btn-finalizar-coleta" @onclick="FinalizarColeta">
                        [ Finalizar Coleta ]
                    </button>
                </div>
            </div>
        }
    }

    <!-- Modal de Confirmação de Saída ("Deseja salvar a coleta?") -->
    @if (exibirModalConfirmarSaida)
    {
        <div class="modal-backdrop-saida" @onclick="() => exibirModalConfirmarSaida = false">
            <div class="modal-dialog-saida" @onclick:stopPropagation="true">
                <div class="modal-saida-header">
                    <h3 class="modal-saida-title">Deseja salvar a coleta?</h3>
                    <p class="modal-saida-sub">Você coletou @coletasSessao.Count produto(s) nesta sessão. O que deseja fazer?</p>
                </div>
                <div class="modal-saida-actions">
                    <button type="button" class="btn-saida-salvar" @onclick="SalvarESair">
                        💾 Salvar e Sair
                    </button>
                    <button type="button" class="btn-saida-descartar" @onclick="DescartarESair">
                        🗑️ Sair sem Salvar
                    </button>
                    <button type="button" class="btn-saida-continuar" @onclick="() => exibirModalConfirmarSaida = false">
                        Continuar Coletando
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Leitor de Código de Barras por Câmera -->
    @if (exibirModalCamera)
    {
        <div class="modal-backdrop-camera" @onclick="FecharScannerCamera">
            <div class="modal-dialog-camera" @onclick:stopPropagation="true">
                <div class="modal-camera-header">
                    <div class="camera-header-info">
                        <span class="camera-icon-badge">📷</span>
                        <h3>Leitor de Código de Barras</h3>
                    </div>
                    <button type="button" class="btn-fechar-camera" @onclick="FecharScannerCamera">×</button>
                </div>

                <div class="camera-viewport-box">
                    <div id="cameraScannerContainer"></div>
                    <div class="scanner-laser-line"></div>
                    <div class="scanner-aim-frame">
                        <span class="corner-tl"></span>
                        <span class="corner-tr"></span>
                        <span class="corner-bl"></span>
                        <span class="corner-br"></span>
                    </div>
                    @if (!string.IsNullOrEmpty(statusScannerCamera))
                    {
                        <div class="scanner-status-overlay">@statusScannerCamera</div>
                    }
                </div>

                <div class="camera-footer">
                    <p class="camera-tip">Aponte a câmera para o código de barras (EAN-13, EAN-8 ou Code 128)</p>
                    <button type="button" class="btn-fechar-camera-footer" @onclick="FecharScannerCamera">
                        Digitar Código Manualmente
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Loja> lojas = new();
    private int lojaSelecionadaId;
    private string LojaSelecionadaNome => lojas.FirstOrDefault(l => l.Id == lojaSelecionadaId)?.Nome ?? "Loja";
    private string LojaSelecionadaSigla => lojas.FirstOrDefault(l => l.Id == lojaSelecionadaId)?.CodigoLoja ?? $"LJ-{lojaSelecionadaId}";

    private HashSet<int> lojasAlvoIds = new();
    private bool TodasLojasSelecionadas => lojas.Count > 0 && lojasAlvoIds.Count == lojas.Count;

    private string codigoBarrasInput = string.Empty;
    private bool carregandoBusca = false;
    private List<Produto> produtosEncontrados = new();

    // Itens Coletados na Sessão Ativa
    private List<ItemColetaSessao> coletasSessao = new();

    // Modal de Registro / Inclusão de Validade
    private bool exibirFormularioRegistro = false;
    private Produto? produtoAlvo = null;
    private bool modoInedito = false;
    private string novoProdutoNome = string.Empty;
    private DateTime novaDataValidade = DateTime.Today.AddDays(7);
    private bool novoLoteEmPromocao = false;

    // Modais de Controle
    private bool exibirModalConfirmarSaida = false;
    private bool exibirModalCamera = false;

    // Feedback
    private string feedbackMensagem = string.Empty;
    private string feedbackTipo = "success";

    private DotNetObjectReference<Coleta>? dotNetHelper;

    protected override async Task OnInitializedAsync()
    {
        dotNetHelper = DotNetObjectReference.Create(this);
        lojas = await ValidadeService.GetLojasAsync();

        if (lojas.Any())
        {
            lojaSelecionadaId = lojas.First().Id;
            lojasAlvoIds.Clear();
            lojasAlvoIds.Add(lojaSelecionadaId);
        }
    }

    private async Task OnLojaAlterada()
    {
        if (!lojasAlvoIds.Contains(lojaSelecionadaId))
        {
            lojasAlvoIds.Add(lojaSelecionadaId);
        }
        await ExecutarBuscaAsync();
    }

    private async Task OnBuscaInputAlterado(ChangeEventArgs e)
    {
        codigoBarrasInput = e.Value?.ToString() ?? string.Empty;
        await ExecutarBuscaAsync();
    }

    private async Task ExecutarBuscaAsync()
    {
        var termo = codigoBarrasInput.Trim();
        if (string.IsNullOrWhiteSpace(termo))
        {
            produtosEncontrados.Clear();
            carregandoBusca = false;
            return;
        }

        carregandoBusca = true;
        try
        {
            produtosEncontrados = await ValidadeService.BuscarProdutosPorTermoAsync(termo, limite: 12);
        }
        finally
        {
            carregandoBusca = false;
        }
    }

    private void LimparBusca()
    {
        codigoBarrasInput = string.Empty;
        produtosEncontrados.Clear();
        carregandoBusca = false;
    }

    private void IniciarRegistroValidade(Produto prod)
    {
        produtoAlvo = prod;
        modoInedito = false;
        novoProdutoNome = prod.Nome;
        novaDataValidade = DateTime.Today.AddDays(7);
        novoLoteEmPromocao = false;
        lojasAlvoIds.Clear();
        lojasAlvoIds.Add(lojaSelecionadaId);
        exibirFormularioRegistro = true;
    }

    private void IniciarCadastroInedito()
    {
        produtoAlvo = new Produto
        {
            CodigoBarras = codigoBarrasInput.Trim(),
            Nome = string.Empty
        };
        modoInedito = true;
        novoProdutoNome = string.Empty;
        novaDataValidade = DateTime.Today.AddDays(7);
        novoLoteEmPromocao = false;
        lojasAlvoIds.Clear();
        lojasAlvoIds.Add(lojaSelecionadaId);
        exibirFormularioRegistro = true;
    }

    private void FecharFormularioRegistro()
    {
        exibirFormularioRegistro = false;
        produtoAlvo = null;
    }

    private void AlternarSelecionarTodasLojas()
    {
        if (TodasLojasSelecionadas)
        {
            lojasAlvoIds.Clear();
            lojasAlvoIds.Add(lojaSelecionadaId);
        }
        else
        {
            lojasAlvoIds = lojas.Select(l => l.Id).ToHashSet();
        }
    }

    private void ToggleLojaAlvo(int lojaId, bool ativo)
    {
        if (ativo) lojasAlvoIds.Add(lojaId);
        else lojasAlvoIds.Remove(lojaId);
    }

    private void ConfirmarAdicionarLoteSessao()
    {
        if (produtoAlvo == null) return;

        var nomeFinal = modoInedito ? novoProdutoNome.Trim() : produtoAlvo.Nome.Trim();
        if (string.IsNullOrWhiteSpace(nomeFinal))
        {
            feedbackMensagem = "Por favor, preencha o nome do produto.";
            feedbackTipo = "warning";
            return;
        }

        if (!lojasAlvoIds.Any())
        {
            feedbackMensagem = "Selecione ao menos uma loja para registrar a validade.";
            feedbackTipo = "warning";
            return;
        }

        foreach (var lId in lojasAlvoIds)
        {
            var loja = lojas.FirstOrDefault(l => l.Id == lId);
            coletasSessao.Add(new ItemColetaSessao
            {
                ProdutoId = modoInedito ? null : produtoAlvo.Id,
                CodigoBarras = produtoAlvo.CodigoBarras.Trim(),
                NomeProduto = nomeFinal,
                LojaId = lId,
                LojaNome = loja?.Nome ?? "Loja",
                LojaSigla = !string.IsNullOrWhiteSpace(loja?.CodigoLoja) ? loja.CodigoLoja : $"LJ-{lId}",
                DataValidade = novaDataValidade,
                EmPromocao = novoLoteEmPromocao,
                EhProdutoNovo = modoInedito
            });
        }

        feedbackMensagem = $"Validade de '{nomeFinal}' adicionada à coleta! ({coletasSessao.Count} na sessão)";
        feedbackTipo = "success";

        FecharFormularioRegistro();
        LimparBusca();
    }

    private void RemoverItemSessao(ItemColetaSessao item)
    {
        coletasSessao.Remove(item);
    }

    private async Task FinalizarColeta()
    {
        if (!coletasSessao.Any()) return;

        try
        {
            await ValidadeService.SalvarLoteColetasAsync(coletasSessao);
            var total = coletasSessao.Count;
            coletasSessao.Clear();
            feedbackMensagem = $"Coleta de {total} item(ns) gravada com sucesso!";
            feedbackTipo = "success";
        }
        catch (Exception ex)
        {
            feedbackMensagem = $"Erro ao salvar coleta: {ex.Message}";
            feedbackTipo = "warning";
        }
    }

    private void TentarVoltar()
    {
        if (coletasSessao.Any())
        {
            exibirModalConfirmarSaida = true;
        }
        else
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task SalvarESair()
    {
        await FinalizarColeta();
        exibirModalConfirmarSaida = false;
        Navigation.NavigateTo("/");
    }

    private void DescartarESair()
    {
        coletasSessao.Clear();
        exibirModalConfirmarSaida = false;
        Navigation.NavigateTo("/");
    }

    // Leitor de Código de Barras por Câmera
    private string? statusScannerCamera;

    private async Task AbrirScannerCamera()
    {
        exibirModalCamera = true;
        statusScannerCamera = "Iniciando câmera...";
        await Task.Delay(250);
        try
        {
            await JSRuntime.InvokeVoidAsync("validataScanner.iniciar", dotNetHelper, "cameraScannerContainer");
        }
        catch (Exception ex)
        {
            statusScannerCamera = "Erro: " + ex.Message;
            Console.WriteLine($"Erro ao abrir scanner de câmera: {ex.Message}");
        }
    }

    private async Task FecharScannerCamera()
    {
        exibirModalCamera = false;
        statusScannerCamera = null;
        try
        {
            await JSRuntime.InvokeVoidAsync("validataScanner.parar");
        }
        catch {}
    }

    [JSInvokable]
    public void OnScannerStatus(string status)
    {
        statusScannerCamera = status;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnCodigoBarrasDetectado(string codigo)
    {
        if (string.IsNullOrWhiteSpace(codigo)) return;

        await FecharScannerCamera();
        codigoBarrasInput = codigo.Trim();
        await ExecutarBuscaAsync();

        if (produtosEncontrados.Count == 1)
        {
            // Abre direto o formulário de data para o produto bipado
            IniciarRegistroValidade(produtosEncontrados.First());
        }
        else if (produtosEncontrados.Count == 0)
        {
            // Abre direto para cadastrar produto inédito
            IniciarCadastroInedito();
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("validataScanner.parar");
        }
        catch {}
        dotNetHelper?.Dispose();
    }
}
